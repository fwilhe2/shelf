[Unit]
Description=shelf - simple home NAS
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
# The user that owns the stored files. Must be able to read /etc/shelf/config.json
# and write to all share directories.
User=shelf
Group=shelf
ExecStart=/usr/local/bin/shelf serve -c /etc/shelf/config.json
Restart=on-failure
UMask=0002

# Hardening: shelf only needs to touch its share directories.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
